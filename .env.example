# Earth Browser Environment Configuration (Optional)
# Sensible defaults are provided out-of-the-box, so a .env file is optional.

# Port for the Express backend server (default: 3000)
PORT=3000

# Host interface for Express server (default: 0.0.0.0)
HOST=0.0.0.0

# PostgreSQL container host port mapping (default: 5432)
# Change if port 5432 is already used by a host PostgreSQL instance (e.g. POSTGRES_PORT=5434)
POSTGRES_PORT=5432

# PostgreSQL / PostGIS connection string (default: postgres://postgres:postgres@127.0.0.1:5432/world)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/world

