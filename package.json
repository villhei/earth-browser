{
  "name": "earth-browser",
  "version": "1.0.0",
  "description": "3D WebGL Earth browser visualizing historical world country boundaries and geospatial datasets",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm run server:dev\" \"npm run client:dev\"",
    "client:dev": "vite",
    "server:dev": "tsx watch server.ts",
    "server": "tsx server.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "knex": "tsx ./node_modules/.bin/knex",
    "migrate": "tsx ./node_modules/.bin/knex migrate:latest",
    "codegen": "graphql-codegen --config codegen.ts",
    "test": "vitest run",
    "start": "npm run dev"
  },
  "dependencies": {
    "@apollo/client": "^3.11.8",
    "@graphile-contrib/pg-simplify-inflector": "^6.1.0",
    "color-alpha": "^1.1.3",
    "cors": "^2.8.5",
    "country-flag-colors": "^0.0.3",
    "express": "^4.21.0",
    "graphql": "^15.8.0",
    "knex": "^3.1.0",
    "knex-postgis": "^0.14.3",
    "leva": "^0.9.35",
    "pg": "^8.13.0",
    "postgraphile": "^4.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-spinners": "^0.14.1",
    "three": "^0.169.0",
    "three-globe": "^2.31.2"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.3",
    "@graphql-codegen/near-operation-file-preset": "^3.0.0",
    "@graphql-codegen/typescript": "^4.1.0",
    "@graphql-codegen/typescript-operations": "^4.3.0",
    "@graphql-codegen/typescript-react-apollo": "^4.3.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.1"
  },
  "overrides": {
    "graphql": "$graphql"
  }
}
