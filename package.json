{
  "name": "earth-browser",
  "version": "2.0.0",
  "description": "3D WebGL Earth browser visualizing historical world country boundaries and geospatial datasets across different eras",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm run server:dev\" \"npm run client:dev\"",
    "client:dev": "vite",
    "server:dev": "tsx watch server.ts",
    "server": "tsx server.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "knex": "tsx ./node_modules/.bin/knex",
    "migrate": "tsx ./node_modules/.bin/knex migrate:latest",
    "db:ingest": "tsx src/server/ingest.ts",
    "db:setup": "npm run migrate && npm run db:ingest",
    "db:reset": "npm run knex -- migrate:rollback --all && npm run db:setup",
    "test": "vitest run",
    "start": "npm run dev"
  },
  "dependencies": {
    "color-alpha": "^1.1.3",
    "cors": "^2.8.5",
    "country-flag-colors": "^0.0.3",
    "express": "^4.21.0",
    "knex": "^3.1.0",
    "knex-postgis": "^0.14.3",
    "pg": "^8.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-spinners": "^0.14.1",
    "three": "^0.169.0",
    "three-globe": "^2.31.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.1"
  }
}
